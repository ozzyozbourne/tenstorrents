+// B04 lab: trace the Tensix instructions of ONE tile, gated by environment variables.
+//   B04_OUT=file   enables the trace;  B04_TILE=n (default 0);  B04_PIPES=mask of threads T0/T1/T2 (default 7)
+struct B04Trace {
+    FILE *f = nullptr;
+    uint32_t tile = 0, pipes = 7;
+    uint64_t first_try[TENSIX_INST_PIPES] = {}; // clock of the first failed attempt of the head instruction
+    uint64_t tries[TENSIX_INST_PIPES] = {};     // failed attempts so far
+    B04Trace() {
+        if (const char *p = getenv("B04_OUT")) f = fopen(p, "w");
+        if (f) setvbuf(f, nullptr, _IOLBF, 0); // line-buffered: ttsim errors end the process without flushing
+        if (const char *p = getenv("B04_TILE")) tile = atoi(p);
+        if (const char *p = getenv("B04_PIPES")) pipes = strtoul(p, nullptr, 0);
+    }
+    ~B04Trace() { if (f) fclose(f); }
+    bool on(const TensixState *p_tensix, uint32_t pipe) const {
+        return f && (p_tensix->tile_id == tile) && ((pipes >> pipe) & 1);
+    }
+};
+static B04Trace s_b04;
+uint64_t g_b04_round;            // issue rounds of the traced tile (libttsim.cpp clocks a tile several rounds per clock)
+uint32_t b04_trace_tile() { return s_b04.tile; }
 
 #define IS_TENSIX_NOP(inst) (bits<31,24>(inst) == TENSIX_OPCODE_NOP)
 
