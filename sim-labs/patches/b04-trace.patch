+    bool done = tensix_execute_inst(p_tensix, pipe, inst);
+    if (s_b04.on(p_tensix, pipe)) {
+        if (!done) {
+            if (!s_b04.tries[pipe]++) s_b04.first_try[pipe] = g_clock; // stalled: the FIFO head retries later
+        } else {
+            // X <clock> <round> T<pipe> <instruction> <failed tries> <clocks spent stalled>
+            uint64_t stall_clks = s_b04.tries[pipe] ? g_clock - s_b04.first_try[pipe] : 0;
+            fprintf(s_b04.f, "X %llu %llu T%u %08x %llu %llu\n", (unsigned long long)g_clock, (unsigned long long)g_b04_round, pipe, inst,
+                    (unsigned long long)s_b04.tries[pipe], (unsigned long long)stall_clks);
+            s_b04.tries[pipe] = 0;
+        }
+    }
+    return done;
 }
