+// B02 lab: watch SOFT_RESET_0 and the reset PCs. B02_RESET=1 prints writes that start or stop a core,
+// B02_RESET=2 prints every write; B02_TILE=<id> keeps only one Tensix tile.
+static uint32_t s_b02_writer = 0xFFFFFFFF; // hart id doing the MMIO write, or 0xFFFFFFFF for host/NoC
+int b02_reset_level(uint32_t tile_id) {
+    static const char *level = getenv("B02_RESET");
+    static const char *tile = getenv("B02_TILE");
+    if (!level || (tile && uint32_t(atoi(tile)) != tile_id)) {
+        return 0;
+    }
+    return atoi(level);
+}
+
+// B02: log changes to the reset-PC registers (WH: Tensix config registers, BH: debug registers)
+void b02_reset_pc_wr(uint32_t tile_id, const char *name, uint32_t old_value, uint32_t value) {
+    if ((value != old_value) && b02_reset_level(tile_id)) {
+        ttsim_printf("B02 reset T%u cfg %s = 0x%x\n", tile_id, name, value);
+    }
+}
