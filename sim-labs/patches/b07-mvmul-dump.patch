+// B07 lab: dump the operands and Dst rows of MVMULs on ONE tile, gated by environment variables.
+//   B07_OUT=file enables it;  B07_TILE=n (default 0);  B07_SKIP=k MVMULs to skip first (default 0);
+//   B07_COUNT=n MVMULs to dump after that (default 64). Values are raw: Src cells as stored (32-bit, low 13 bits
+//   zero), Dst cells as read_dst16b/read_dst32b return them (still in Dst's storage encoding).
+struct B07Dump {
+    FILE *f = nullptr;
+    uint32_t tile = 0;
+    uint64_t skip = 0, count = 64, seen = 0;
+    B07Dump() {
+        if (const char *p = getenv("B07_OUT")) f = fopen(p, "w");
+        if (const char *p = getenv("B07_TILE")) tile = atoi(p);
+        if (const char *p = getenv("B07_SKIP")) skip = strtoull(p, nullptr, 0);
+        if (const char *p = getenv("B07_COUNT")) count = strtoull(p, nullptr, 0);
+    }
+    ~B07Dump() { if (f) { fprintf(f, "T %llu\n", (unsigned long long)seen); fclose(f); } } // total MVMULs on the tile
+    bool want(const TensixState *p_tensix) { // call once per MVMUL that executes on any tile
+        if (!f || p_tensix->tile_id != tile) return false;
+        uint64_t n = seen++;
+        return n >= skip && n < skip + count;
+    }
+    void dst_rows(TensixState *p_tensix, char tag, uint32_t dst_row, bool d32) {
+        for (uint32_t r = 0; r < 8; r++) {
+            fputc(tag, f);
+            for (uint32_t c = 0; c < ROW_SIZE; c++)
+                fprintf(f, d32 ? " %08x" : " %04x", d32 ? read_dst32b(p_tensix, dst_row + r, c) : read_dst16b(p_tensix, dst_row + r, c));
+            fputc('\n', f);
+        }
+    }
+};
+static B07Dump s_b07;
