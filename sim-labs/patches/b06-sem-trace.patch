+// B06 lab: log Tensix semaphore traffic (SEMINIT/SEMPOST/SEMGET/SEMWAIT and TRISC MMIO accesses) of ONE tile.
+//   B06_SEM_OUT=file enables it; B06_TILE=n picks the tile (default 0).
+// Line format: <clock> T<thread> <event> sem<i> <value before>-><value after> max=<m> [detail]
+struct B06SemTrace {
+    FILE *f = nullptr;
+    uint32_t tile = 0;
+    uint64_t blocked_since[3] = {}; // clock of a SEMWAIT's first blocked attempt, per thread (0 = not blocked)
+    uint64_t tries[3] = {};
+    B06SemTrace() {
+        if (const char *p = getenv("B06_SEM_OUT")) f = fopen(p, "w");
+        if (const char *p = getenv("B06_TILE")) tile = atoi(p);
+    }
+    ~B06SemTrace() { if (f) fclose(f); }
+    bool on(uint32_t tile_id) const { return f && tile_id == tile; }
+};
+static B06SemTrace s_b06;
+void b06_sem_mmio(uint32_t tile_id, uint32_t pipe, const char *what, uint32_t sem, uint32_t before, uint32_t after, uint32_t max) {
+    if (s_b06.on(tile_id))
+        fprintf(s_b06.f, "%llu T%u %s sem%u %u->%u max=%u\n", (unsigned long long)g_clock, pipe, what, sem, before, after, max);
+}
 
