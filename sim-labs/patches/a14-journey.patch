+// A14: log the CB counters tt-metal keeps in overlay stream registers (stream n = CB n): received = REMOTE_DEST_BUF_SIZE,
+// acked = REMOTE_DEST_BUF_START (stream_io_map.h). Writes are logged always; reads only when a hart sees a new value.
+static const char *a14_who(uint32_t riscv_id) {
+    static const char *names[] = {"BRISC", "TRISC0", "TRISC1", "TRISC2", "NCRISC"};
+    return (riscv_id & 0x7FFFFFFF) < 5 ? names[riscv_id & 0x7FFFFFFF] : "TENSIX";
+}
+static const char *a14_cbreg(uint64_t addr, uint32_t *p_cb) {
+    if (addr < NOC_OVERLAY_BASE || addr > NOC_OVERLAY_LIMIT) return nullptr;
+    uint32_t off = addr - NOC_OVERLAY_BASE, stream = off / 0x1000;
+    *p_cb = stream;
+    if (stream >= 32) return nullptr;
+    if ((off & 0xFFF) == NOC_OVERLAY_STREAM_REMOTE_DEST_BUF_SIZE) return "received";
+    if ((off & 0xFFF) == NOC_OVERLAY_STREAM_REMOTE_DEST_BUF_START) return "acked";
+    return nullptr;
+}
+static void a14_cb_wr(uint32_t tile_id, uint32_t riscv_id, uint64_t addr, uint32_t data) {
+    FILE *f = a14_file(); uint32_t cb; const char *reg;
+    if (f && tile_id == b04_trace_tile() && (reg = a14_cbreg(addr, &cb))) {
+        fprintf(f, "CBW %llu %s cb=%u %s=%u\n", (unsigned long long)g_clock, a14_who(riscv_id), cb, reg, data & 0xFFFF);
+    }
+}
+static void a14_cb_rd(uint32_t tile_id, uint32_t riscv_id, uint64_t addr, uint32_t data) {
+    static uint32_t last[5][32][2];
+    static bool seen[5][32][2];
+    FILE *f = a14_file(); uint32_t cb; const char *reg; uint32_t r = riscv_id & 0x7FFFFFFF;
+    if (f && tile_id == b04_trace_tile() && r < 5 && (reg = a14_cbreg(addr, &cb))) {
+        uint32_t k = reg[0] == 'a';
+        if (!seen[r][cb][k] || last[r][cb][k] != data) {
+            fprintf(f, "CBR %llu %s cb=%u %s=%u\n", (unsigned long long)g_clock, a14_who(riscv_id), cb, reg, data & 0xFFFF);
+            seen[r][cb][k] = true; last[r][cb][k] = data;
+        }
+    }
