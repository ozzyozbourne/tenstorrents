+static void a17_log_write(uint32_t offset, uint32_t size, const void *p) {
+    if (a17_log_left < 0) { const char *e = getenv("A17_TLBLOG"); a17_log_left = e ? atoi(e) : 0; }
+    if (!a17_log_left) return;
+    a17_log_left--;
+    uint32_t tlb_index, window_bits;
+    if (offset < 0x9C00000) { tlb_index = offset / 0x100000; window_bits = 20; }
+    else if (offset < 0xB000000) { tlb_index = ((offset - 0x9C00000) / 0x200000) + 156; window_bits = 21; }
