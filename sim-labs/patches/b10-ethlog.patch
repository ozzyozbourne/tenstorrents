+// B10 lab: B10_ETH_IDLE_STEPS=N gives an idle eth core N steps per clock instead of 1 (a speed knob only).
+static uint32_t b10_idle_eth_steps() {
+    static uint32_t steps = 0;
+    if (!steps) {
+        const char *s = getenv("B10_ETH_IDLE_STEPS");
+        steps = s ? (uint32_t)atoi(s) : 1;
+        steps = steps ? steps : 1;
+    }
+    return steps;
+}
