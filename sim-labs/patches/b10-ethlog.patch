+// B10 lab: log one Ethernet transfer. Set B10_ETHLOG=1 to enable. A 32-byte send to the peer's
+// request/response inbox (0x14900/0x14A00) is a header of ttsim's mock eth fw (fw/eth/eth_fw.c), so decode it.
+static void b10_eth_log(const char *kind, uint32_t tile_id, uint32_t remote_chip_id, uint32_t remote_tile_id,
+                        uint32_t src, uint32_t dst, uint32_t size, const uint8_t *p_src) {
+    static int on = -1;
+    if (on < 0) {
+        on = getenv("B10_ETHLOG") != nullptr;
+    }
+    if (!on) {
+        return;
+    }
+    if (size == 32 && (dst == 0x14900 || dst == 0x14A00)) {
+        const uint32_t *w = (const uint32_t *)p_src;
+        ttsim_printf("B10 ETH %s c%u:E%u -> c%u:E%u src=0x%x dst=0x%x n=%u HDR seq=%u op=%u addr=0x%x mid=0x%x size=%u data=0x%x\n",
+            kind, g_current_chip_id, tile_id, remote_chip_id, remote_tile_id, src, dst, size, w[0], w[1], w[2], w[3], w[4], w[5]);
+    } else if (size >= 48 && dst >= 0x18000) { // B10: a fabric router packet: dump the 48-byte header + 2 payload words
+        const uint32_t *w = (const uint32_t *)p_src;
+        ttsim_printf("B10 ETH %s c%u:E%u -> c%u:E%u src=0x%x dst=0x%x n=%u W %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x | %08x %08x\n",
+            kind, g_current_chip_id, tile_id, remote_chip_id, remote_tile_id, src, dst, size,
+            w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11], w[12], w[13]);
+    } else {
+        ttsim_printf("B10 ETH %s c%u:E%u -> c%u:E%u src=0x%x dst=0x%x n=%u\n",
+            kind, g_current_chip_id, tile_id, remote_chip_id, remote_tile_id, src, dst, size);
+    }
+}
