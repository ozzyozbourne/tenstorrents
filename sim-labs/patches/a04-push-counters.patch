+    { int32_t occ = (int32_t)inst_wr_ptr - (int32_t)p_tensix->inst_rd_ptr[pipe]; if (occ < 0) occ += TENSIX_INST_FIFO_SIZE; if ((uint32_t)occ > g_a04_maxocc[pipe]) g_a04_maxocc[pipe] = occ; }
     p_tensix->inst_pipes_active |= 1 << pipe;
     ttsim_t_tile_set_busy(p_tensix->tile_id);
 
