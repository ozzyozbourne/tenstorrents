+// B05: optionally complete Tensix NoC reads TTSIM_NOC_READ_DELAY clocks after they are issued, instead of at once.
+// The data copy and the NIU_MST_RD_RESP_RECEIVED increment both wait, as they would on silicon, and the read counts
+// as outstanding for its transaction ID until then (noc_async_read_barrier_with_trid polls NIU_MST_REQS_OUTSTANDING_ID).
+struct PendingRead { uint64_t due, issued; uint32_t chip, tile_id, noc, txn_id, src_coord; uint64_t src_addr, dst_addr; uint32_t len; };
+static std::vector<PendingRead> s_pending_reads;
+static uint32_t noc_read_delay() {
+    static int delay = -1;
+    if (delay < 0) { const char *e = getenv("TTSIM_NOC_READ_DELAY"); delay = e ? atoi(e) : 0; }
+    return delay;
+}
+void ttsim_b05_complete_reads() { // called once per clock from clock_current_chip()
+    for (size_t i = 0; i < s_pending_reads.size();) {
+        PendingRead r = s_pending_reads[i];
+        if ((r.chip != g_current_chip_id) || (r.due > g_clock)) { i++; continue; }
+        s_pending_reads.erase(s_pending_reads.begin() + i);
+        TensixTile *p_tile = &g_t_tiles[r.tile_id];
+        tile_rd_bytes(r.src_coord, r.src_addr, &p_tile->sram[r.dst_addr], r.len);
+        p_tile->niu_mst_rd_resp_received[r.noc]++;
+        p_tile->niu_mst_reqs_outstanding[r.noc][r.txn_id]--;
+        uint32_t me = tile_to_coord('T', r.tile_id);
+        ttsim_printf("NOCLOG   done   READ issued at [%llu] core=T(%u,%u) dst=0x%llx len=%u\n",
+            (unsigned long long)r.issued, me & 63, me >> 6, (unsigned long long)r.dst_addr, r.len);
+    }
+}
