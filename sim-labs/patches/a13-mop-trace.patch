+// A13 instrumentation: trace the frontend of the one tile that runs the compute kernel, for the
+// UNPACK (pipe 0) and MATH (pipe 1) threads, until each thread has ingested its third MOP.
+static int a13_tile = -1;
+static uint32_t a13_mops[3], a13_emitted[3];
+static bool a13_on(const TensixState *p, uint32_t pipe) {
+    return (int)p->tile_id == a13_tile && pipe <= 1 && a13_mops[pipe] < 3;
+}
+#define A13_NAME(i) a13_opname[bits<31,24>(i)]
