+// A20 instrumentation: retired Tensix instructions per thread (T0 unpack, T1 math, T2 pack) and per opcode.
+static uint64_t a20_inst[TENSIX_INST_PIPES], a20_op[TENSIX_INST_PIPES][256];
+void a20_dump_tensix() {
+    ttsim_printf("A20 tensix T0=%llu T1=%llu T2=%llu\n", (unsigned long long)a20_inst[0], (unsigned long long)a20_inst[1], (unsigned long long)a20_inst[2]);
+    for (uint32_t p = 0; p < TENSIX_INST_PIPES; p++)
+        for (uint32_t o = 0; o < 256; o++)
+            if (a20_op[p][o]) ttsim_printf("A20 op T%u 0x%02x %llu\n", p, o, (unsigned long long)a20_op[p][o]);
+}
 bool tensix_decode_and_execute(TensixState *p_tensix, uint32_t pipe, uint32_t inst) {
     if (p_tensix->wait_block[pipe] && block_mask_holds(p_tensix->wait_block[pipe], inst)) {
